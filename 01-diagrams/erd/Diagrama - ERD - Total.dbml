// =============================================================================
// MODELO RELACIONAL UNIFICADO
// Sistema de Recomendaciones Dietéticas para SII
// =============================================================================
// Versión unificada que integra los 5 dominios en un único archivo DBML.
// Compatible con dbdiagram.io.
//
// NOTA IMPORTANTE: las políticas ON DELETE (CASCADE, RESTRICT, SET NULL) y
// los CHECK constraints están documentados en el diccionario de datos del TI
// pero no en este archivo, ya que DBML no soporta su sintaxis nativa. Cuando
// se genere el DDL SQL final hay que añadirlos manualmente.
// =============================================================================


// =============================================================================
// DOMINIO 1: IDENTIDAD Y ACCESO
// =============================================================================

Table user_roles {
  role_id integer [primary key, increment]
  role_name varchar(50) [not null, unique, note: 'patient | nutritionist']
  description varchar(255) [null]
  is_active boolean [not null, default: true]

  note: 'Catálogo cerrado de roles humanos del sistema'
}

Table users {
  user_id uuid [primary key, default: `gen_random_uuid()`]
  keycloak_id varchar(100) [not null, unique]
  email varchar(150) [not null, unique]
  full_name varchar(150) [not null]
  role_id integer [not null]
  status varchar(20) [not null, default: 'pending_activation', note: 'active | inactive | pending_activation | suspended']
  email_verified boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  last_login_at timestamp [null]
  failed_login_attempts integer [not null, default: 0]
  locked_until timestamp [null]

  note: 'Tabla maestra de usuarios humanos: pacientes y dietistas-nutricionistas. No almacena contraseñas (delegado a Keycloak)'
}

Table invitation_codes {
  code_id uuid [primary key, default: `gen_random_uuid()`]
  code varchar(20) [not null, unique]
  nutritionist_id uuid [not null]
  used_by_patient_id uuid [null]
  status varchar(20) [not null, default: 'active', note: 'active | used | expired']
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null, note: 'Expira 72 horas después de la generación']
  used_at timestamp [null]

  note: 'Códigos generados por nutricionistas para vincular pacientes durante el registro'
}

Table password_reset_tokens {
  token_id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null, note: 'Expira 30 minutos después de la generación']
  used_at timestamp [null]
  is_used boolean [not null, default: false]

  note: 'Tokens de un solo uso para recuperación de contraseña gestionada por la aplicación'
}

Table consent_records {
  consent_id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [not null]
  document_version varchar(20) [not null]
  accepted_at timestamp [not null, default: `now()`]
  ip_address varchar(45) [null]
  consent_text_hash varchar(64) [not null]
  is_current boolean [not null, default: true]

  note: 'Historial inmutable de aceptaciones del consentimiento informado. Cumplimiento Ley 29733'
}


// =============================================================================
// DOMINIO 2: DATOS CLÍNICOS DEL PACIENTE
// =============================================================================

Table patient_profiles {
  profile_id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, note: 'Relación 1:1 con users. Solo para pacientes']
  date_of_birth date [not null]
  biological_sex varchar(10) [not null, note: 'male | female | other']
  weight_kg decimal(5,2) [not null, note: 'CHECK SQL: > 0 AND < 500']
  height_cm decimal(5,2) [not null, note: 'CHECK SQL: > 0 AND < 250']
  ibs_subtype varchar(10) [not null, note: 'IBS-D | IBS-C | IBS-M | IBS-U (Criterios de Roma IV)']
  diagnosis_date date [null]
  medications text [null]
  onboarding_completed boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  note: 'Perfil clínico exclusivo del paciente. Separado de users por minimización de datos sensibles'
}

Table allergies {
  allergy_id uuid [primary key, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  allergy_type varchar(30) [not null, note: 'allergy (mediada por IgE) | intolerance (metabólica) | sensitivity (no caracterizada)']
  description text [null]
  is_active boolean [not null, default: true]

  note: 'Catálogo cerrado de alergias e intolerancias alimentarias'
}

Table patient_allergies {
  patient_allergy_id uuid [primary key, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  allergy_id uuid [not null]
  severity varchar(20) [not null, note: 'mild | moderate | severe']
  declared_at timestamp [not null, default: `now()`]
  notes varchar(500) [null]

  indexes {
    (patient_id, allergy_id) [unique, name: 'uq_patient_allergy']
  }

  note: 'Tabla de unión M:N entre pacientes y alergias del catálogo'
}

Table nutritionist_patient {
  assignment_id uuid [primary key, default: `gen_random_uuid()`]
  nutritionist_id uuid [not null]
  patient_id uuid [not null]
  invitation_code_id uuid [null]
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  assigned_at timestamp [not null, default: `now()`]
  unassigned_at timestamp [null]

  note: 'Asignación clínica entre nutricionistas y pacientes con histórico'
}


// =============================================================================
// DOMINIO 3: CATÁLOGO ALIMENTARIO Y REGISTRO CLÍNICO DIARIO
// =============================================================================

Table food_items {
  food_id uuid [primary key, default: `gen_random_uuid()`]
  name varchar(150) [not null, unique]
  category varchar(50) [not null, note: 'cereales | proteínas | lácteos | frutas | verduras | leguminosas | preparaciones']
  calories_per_100g decimal(6,2) [not null, default: 0, note: 'CHECK SQL: >= 0. Aporte por 100g, base TPCA-CENAN INS']
  protein_g_per_100g decimal(5,2) [not null, default: 0, note: 'CHECK SQL: >= 0']
  carbs_g_per_100g decimal(5,2) [not null, default: 0, note: 'CHECK SQL: >= 0']
  fat_g_per_100g decimal(5,2) [not null, default: 0, note: 'CHECK SQL: >= 0']
  fiber_g_per_100g decimal(5,2) [not null, default: 0, note: 'CHECK SQL: >= 0']
  fodmap_level varchar(10) [not null, note: 'low | moderate | high']
  fodmap_tags text [null, note: 'Etiquetas controladas: fructans | lactose | polyols | oligos. Aplicar índice GIN']
  is_peruvian boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  note: 'Catálogo oficial de alimentos peruanos. Cargado por script semilla desde TPCA-CENAN INS'
}

Table custom_foods {
  custom_food_id uuid [primary key, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  name varchar(150) [not null]
  portion_size_grams decimal(7,2) [not null, note: 'CHECK SQL: > 0']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (patient_id, name) [unique, name: 'uq_custom_food_per_patient']
  }

  note: 'Preparaciones propias creadas por pacientes. Nutrientes calculados desde ingredientes'
}

Table custom_food_ingredients {
  ingredient_id uuid [primary key, default: `gen_random_uuid()`]
  custom_food_id uuid [not null]
  food_id uuid [not null]
  proportion_grams decimal(6,2) [not null, note: 'CHECK SQL: > 0']

  indexes {
    (custom_food_id, food_id) [unique, name: 'uq_ingredient_per_custom_food']
  }

  note: 'Composición de cada alimento personalizado. Sin duplicados de ingrediente'
}

Table meals {
  meal_id uuid [primary key, default: `gen_random_uuid()`]
  client_guid uuid [not null, unique, note: 'Generado en el dispositivo para idempotencia en sync offline']
  patient_id uuid [not null]
  meal_time varchar(20) [not null, note: 'breakfast | lunch | dinner | snack']
  consumed_at timestamp [not null]
  sync_status varchar(20) [not null, default: 'sync_completed', note: 'sync_pending | sync_completed']
  created_at timestamp [not null, default: `now()`]
  client_created_at timestamp [not null, note: 'Canónico para correlación de ventana de 4h con síntomas. Aplicar índice BTREE']

  note: 'Registro de comidas. Soporta modo offline con sincronización diferida'
}

Table meal_items {
  meal_item_id uuid [primary key, default: `gen_random_uuid()`]
  meal_id uuid [not null]
  food_id uuid [null, note: 'CHECK SQL XOR con custom_food_id: exactamente uno no nulo']
  custom_food_id uuid [null, note: 'CHECK SQL XOR con food_id: exactamente uno no nulo']
  quantity decimal(8,2) [not null, note: 'CHECK SQL: > 0']
  unit varchar(20) [not null, note: 'grams | cups | units | ounces | tablespoons']

  note: 'Detalle de alimentos por comida. CHECK SQL: (food_id IS NULL) <> (custom_food_id IS NULL)'
}

Table symptoms {
  symptom_id uuid [primary key, default: `gen_random_uuid()`]
  client_guid uuid [not null, unique, note: 'Generado en el dispositivo para idempotencia en sync']
  patient_id uuid [not null]
  symptom_type varchar(50) [not null, note: 'abdominal_pain | bloating | flatulence | diarrhea | constipation | other']
  intensity integer [not null, note: 'CHECK SQL: entre 1 y 100. Escala VAS alineada con IBS-SSS']
  occurred_at timestamp [not null]
  associated_meal_id uuid [null, note: 'Comida registrada dentro de la ventana de correlación de 4 horas']
  has_meal_association boolean [not null, default: false, note: 'Denormalización para acelerar consultas del motor IA. Aplicar índice BTREE']
  sync_status varchar(20) [not null, default: 'sync_completed']
  created_at timestamp [not null, default: `now()`]
  client_created_at timestamp [not null, note: 'Aplicar índice BTREE para correlación temporal']

  note: 'Síntomas gastrointestinales. Ventana de 4h justificada por Monash University y Ford et al. 2024'
}

Table clinical_notes {
  note_id uuid [primary key, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  meal_id uuid [null, note: 'CHECK SQL XOR con symptom_id: exactamente uno no nulo']
  symptom_id uuid [null, note: 'CHECK SQL XOR con meal_id: exactamente uno no nulo']
  content varchar(500) [not null, note: 'CHECK SQL: longitud > 0']
  created_at timestamp [not null, default: `now()`]

  note: 'Notas de contexto del paciente: estrés, medicamentos, ciclo menstrual, etc.'
}

Table ibs_sss_assessments {
  assessment_id uuid [primary key, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  assessment_type varchar(20) [not null, note: 'baseline | periodic']
  cycle_number integer [not null, default: 0, note: 'CHECK SQL: >= 0. 0 para línea base. Incrementa con cada ciclo']
  pain_severity integer [not null, note: 'CHECK SQL: entre 0 y 100']
  pain_frequency integer [not null, note: 'CHECK SQL: entre 0 y 100']
  bloating_severity integer [not null, note: 'CHECK SQL: entre 0 y 100']
  bowel_habits_dissatisfaction integer [not null, note: 'CHECK SQL: entre 0 y 100']
  life_interference integer [not null, note: 'CHECK SQL: entre 0 y 100']
  total_score integer [not null, note: 'CHECK SQL: entre 0 y 500. Suma de las 5 dimensiones']
  severity_category varchar(20) [not null, note: 'mild (0-174) | moderate (175-300) | severe (301-500)']
  completed_at timestamp [not null, default: `now()`]
  next_assessment_date date [null, note: 'Próxima evaluación cada 14 días']

  note: 'Evaluaciones IBS-SSS. Instrumento de medición principal del piloto clínico'
}


// =============================================================================
// DOMINIO 4: RECOMENDACIONES E INTELIGENCIA ARTIFICIAL
// =============================================================================

Table model_versions {
  version_id uuid [primary key, default: `gen_random_uuid()`]
  version_name varchar(50) [not null, unique, note: 'Versionado semántico: v1.0.0, v1.1.0']
  model_hash varchar(64) [not null, unique, note: 'Hash SHA-256 del archivo ONNX']
  training_dataset_size integer [null]
  performance_metrics jsonb [null, note: 'precision, recall, F1, AUC-ROC en JSON']
  deployed_at timestamp [not null, default: `now()`]
  deployed_by varchar(100) [not null, note: 'Identificador del operador o script administrativo del despliegue']
  is_active boolean [not null, default: false, note: 'Solo una versión activa simultáneamente']

  note: 'Versiones del modelo XGBoost en formato ONNX. Provisioning técnico vía script administrativo'
}

Table recommendations {
  recommendation_id uuid [primary key, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  model_version_id uuid [not null]
  status varchar(30) [not null, default: 'Generated', note: 'Generated | Pending_Review | Approved | Rejected | Delivered | Feedback_Received | Expired']
  confidence_score decimal(4,3) [not null, note: 'CHECK SQL: entre 0.000 y 1.000']
  auto_approved boolean [not null, default: false]
  reviewed_by_nutritionist_id uuid [null]
  nutritionist_note text [null, note: 'Nota clínica obligatoria al aprobar o rechazar en flujo HITL']
  ai_explanation text [null, note: 'Explicación generada por LLM con guardrails']
  explanation_source varchar(20) [not null, default: 'llm_generated', note: 'llm_generated | fallback']
  generated_at timestamp [not null, default: `now()`]
  reviewed_at timestamp [null]
  delivered_at timestamp [null]
  expires_at timestamp [null]

  note: 'Recomendaciones dietéticas. Máquina de estados de 7 valores que materializa el flujo HITL'
}

Table recommendation_items {
  recommendation_item_id uuid [primary key, default: `gen_random_uuid()`]
  recommendation_id uuid [not null]
  food_id uuid [not null]
  action_type varchar(20) [not null, note: 'suggest | reduce | avoid | substitute']
  substitute_food_id uuid [null, note: 'Alimento sustituto cuando action_type es substitute']
  reasoning text [null]

  note: 'Detalle de alimentos por recomendación con su acción específica'
}

Table recommendation_feedback {
  feedback_id uuid [primary key, default: `gen_random_uuid()`]
  recommendation_id uuid [not null, unique, note: 'Una recomendación tiene máximo un feedback']
  was_applied boolean [not null]
  outcome varchar(20) [not null, note: 'improvement | no_change | worsening']
  comment varchar(500) [null]
  sync_status varchar(20) [not null, default: 'sync_completed']
  submitted_at timestamp [not null, default: `now()`]

  note: 'Retroalimentación del paciente sobre eficacia clínica. Insumo para reentrenamiento del modelo'
}


// =============================================================================
// DOMINIO 5: AUDITORÍA Y OPERACIONES
// =============================================================================

Table audit_logs {
  log_id bigserial [primary key, note: 'BIGSERIAL por eficiencia en inserciones de alto volumen']
  actor_user_id uuid [null, note: 'Nulo cuando la acción la ejecuta el sistema automáticamente']
  action_type varchar(50) [not null, note: 'INSERT | UPDATE | DELETE | LOGIN | LOGOUT | APPROVE | REJECT | EXPORT | DELETE_ACCOUNT | FAILED_LOGIN']
  table_affected varchar(100) [null]
  record_id uuid [null]
  old_values_hash varchar(64) [null, note: 'Hash SHA-256 de valores antes del cambio']
  new_values_hash varchar(64) [null, note: 'Hash SHA-256 de valores después del cambio']
  ip_address varchar(45) [null]
  user_agent varchar(255) [null]
  timestamp timestamp [not null, default: `now()`, note: 'UTC. Inmutable mediante triggers BEFORE UPDATE/DELETE']
  additional_context jsonb [null, note: 'Contexto estructurado para eventos complejos']

  note: 'Registro inmutable. Auditoría en doble capa: middleware aplicativo + triggers BD. Cumplimiento Ley 29733'
}

Table notifications {
  notification_id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [not null]
  notification_type varchar(50) [not null, note: 'recommendation | reminder | alert | system']
  channel varchar(20) [not null, note: 'push | email']
  title varchar(150) [not null]
  body text [not null]
  status varchar(20) [not null, default: 'pending', note: 'pending | sent | delivered | failed']
  retry_count integer [not null, default: 0, note: 'CHECK SQL: <= 3. Política de reintentos con backoff exponencial']
  related_entity_type varchar(50) [null, note: 'recommendation | ibs_sss_assessment']
  related_entity_id uuid [null, note: 'ID de entidad para deep linking']
  scheduled_for timestamp [not null]
  sent_at timestamp [null]
  delivered_at timestamp [null]
  error_message text [null]

  note: 'Bitácora de notificaciones push y correos con política de reintentos'
}


// =============================================================================
// RELACIONES (organizadas por dominio de origen)
// =============================================================================

// --- Dominio 1: Identidad y Acceso ---
Ref: users.role_id > user_roles.role_id
Ref: invitation_codes.nutritionist_id > users.user_id
Ref: invitation_codes.used_by_patient_id > users.user_id
Ref: password_reset_tokens.user_id > users.user_id
Ref: consent_records.user_id > users.user_id

// --- Dominio 2: Datos Clínicos del Paciente ---
Ref: patient_profiles.user_id - users.user_id
Ref: patient_allergies.patient_id > users.user_id
Ref: patient_allergies.allergy_id > allergies.allergy_id
Ref: nutritionist_patient.nutritionist_id > users.user_id
Ref: nutritionist_patient.patient_id > users.user_id
Ref: nutritionist_patient.invitation_code_id > invitation_codes.code_id

// --- Dominio 3: Catálogo Alimentario y Registro Clínico Diario ---
Ref: custom_foods.patient_id > users.user_id
Ref: custom_food_ingredients.custom_food_id > custom_foods.custom_food_id
Ref: custom_food_ingredients.food_id > food_items.food_id
Ref: meals.patient_id > users.user_id
Ref: meal_items.meal_id > meals.meal_id
Ref: meal_items.food_id > food_items.food_id
Ref: meal_items.custom_food_id > custom_foods.custom_food_id
Ref: symptoms.patient_id > users.user_id
Ref: symptoms.associated_meal_id > meals.meal_id
Ref: clinical_notes.patient_id > users.user_id
Ref: clinical_notes.meal_id > meals.meal_id
Ref: clinical_notes.symptom_id > symptoms.symptom_id
Ref: ibs_sss_assessments.patient_id > users.user_id

// --- Dominio 4: Recomendaciones e Inteligencia Artificial ---
Ref: recommendations.patient_id > users.user_id
Ref: recommendations.model_version_id > model_versions.version_id
Ref: recommendations.reviewed_by_nutritionist_id > users.user_id
Ref: recommendation_items.recommendation_id > recommendations.recommendation_id
Ref: recommendation_items.food_id > food_items.food_id
Ref: recommendation_items.substitute_food_id > food_items.food_id
Ref: recommendation_feedback.recommendation_id - recommendations.recommendation_id

// --- Dominio 5: Auditoría y Operaciones ---
Ref: audit_logs.actor_user_id > users.user_id
Ref: notifications.user_id > users.user_id


// =============================================================================
// AGRUPACIÓN VISUAL POR DOMINIO (TableGroups en dbdiagram.io)
// =============================================================================

TableGroup "Dominio 1: Identidad y Acceso" {
  user_roles
  users
  invitation_codes
  password_reset_tokens
  consent_records
}

TableGroup "Dominio 2: Datos Clinicos del Paciente" {
  patient_profiles
  allergies
  patient_allergies
  nutritionist_patient
}

TableGroup "Dominio 3: Catalogo Alimentario y Registro Clinico" {
  food_items
  custom_foods
  custom_food_ingredients
  meals
  meal_items
  symptoms
  clinical_notes
  ibs_sss_assessments
}

TableGroup "Dominio 4: Recomendaciones e Inteligencia Artificial" {
  model_versions
  recommendations
  recommendation_items
  recommendation_feedback
}

TableGroup "Dominio 5: Auditoria y Operaciones" {
  audit_logs
  notifications
}
